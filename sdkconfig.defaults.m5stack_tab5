# M5Stack Tab5 board defaults
# This board has 16 MB DIO flash and 32 MB hex/octal PSRAM.
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MEMTEST=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Tab5's ESP32-C6 uses ESP-Hosted SDIO with these board-specific connections.
CONFIG_ESP32P4_TAB5_C6_BOARD=y
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CLK_SLOT_1=12
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CMD_SLOT_1=13
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D0_SLOT_1=11
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D1_4BIT_BUS_SLOT_1=10
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D2_4BIT_BUS_SLOT_1=9
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D3_4BIT_BUS_SLOT_1=8
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=15
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_HIGH=y

# Original Tab5 hardware uses pre-v3 ESP32-P4 silicon. ESP-IDF groups
# revisions 1.0 through 1.99 under REV_MIN_100; rev 1.x and rev 3.x binaries
# are not hardware-compatible. The connected board reports v1.0 at boot.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y

# ESP-IDF 6.1 allocates the light-sleep clock-retention REGDMA tables during
# startup. They are unused by this always-on photo frame and can exhaust the
# ESP32-P4's early internal-memory heap.
# CONFIG_PM_SLEEP_CLK_ICG_ENABLE is not set

CONFIG_BSP_I2C_NUM=1
CONFIG_BSP_DISPLAY_BRIGHTNESS_LEDC_CH=1
CONFIG_BSP_SD_MOUNT_POINT="/sdcard"
CONFIG_BSP_SD_FORMAT_ON_MOUNT_FAIL=n
CONFIG_BSP_LCD_DRAW_BUF_HEIGHT=40
CONFIG_BSP_LCD_DPI_BUFFER_NUMS=1
CONFIG_BSP_LCD_USE_DMA2D=y
# The app rotates the display from BMI270 readings. Avoid-tear mode disables
# the BSP's software/PPA rotation path, so use partial display buffers.
CONFIG_BSP_DISPLAY_LVGL_AVOID_TEAR=n

# Use the ESP32-P4 Pixel Processing Accelerator for LVGL rendering and display
# rotation. A 40-line draw buffer keeps the three required DMA buffers within
# the Tab5's available contiguous internal memory.
CONFIG_LV_USE_PPA=y
CONFIG_LV_USE_PPA_IMG=y
CONFIG_LV_DRAW_BUF_ALIGN=64
CONFIG_LVGL_PORT_ENABLE_PPA=y

# Collect FreeRTOS task runtime counters for the dashboard's CPU usage estimate.
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_COUNTER_TYPE_U64=y
