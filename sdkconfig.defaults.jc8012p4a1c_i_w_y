# JC8012P4A1C_I_W_Y target.
# C6 ESP-Hosted transport is inherited from sdkconfig.defaults.esp32p4.
# Guition's JC8012 specifications list 16 MB flash and 32 MB PSRAM. Its ESP-IDF
# LVGL example uses QIO flash and 200 MHz PSRAM; PSRAM capacity is detected at
# boot, so ESP-IDF has no fixed size setting here.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPI_FLASH_SUPPORT_BOYA_CHIP=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y

# Use this project's partition map, which fits within the board's 16 MB flash.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Keep the IDF 6.1 P4 bootloader within the existing 24 KB bootloader region.
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y

# JC8012 P4-to-C6 SDIO wiring, verified against the board reference:
# CLK=18, CMD=19, D0..D3=14..17, reset=54 (active high).
CONFIG_ESP_HOSTED_SDIO_PIN_CLK=18
CONFIG_ESP_HOSTED_SDIO_PIN_CMD=19
CONFIG_ESP_HOSTED_SDIO_PIN_D0=14
CONFIG_ESP_HOSTED_SDIO_PIN_D1=15
CONFIG_ESP_HOSTED_SDIO_PIN_D2=16
CONFIG_ESP_HOSTED_SDIO_PIN_D3=17
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=54
CONFIG_ESP_HOSTED_GPIO_SLAVE_RESET_SLAVE=54
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_HIGH=y
CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=20000

# LCD/reset, touch, RTC and SD-card driver integration remains incomplete.
